# Optional Cloudflare RealtimeKit credentials (server secrets only).
# Add them with `wrangler secret put`; never expose them as NEXT_PUBLIC values.
REALTIMEKIT_ORG_ID=
REALTIMEKIT_API_KEY=

# Required server secret used to protect phone-number identity hashes.
PHONE_HASH_PEPPER=

# BOOTSTRAP_TOKEN is temporary. Set it only while creating the first
# super administrator, then remove it with `wrangler secret delete`.
