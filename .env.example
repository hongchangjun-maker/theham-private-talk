# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase value
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare RealtimeKit server credentials
